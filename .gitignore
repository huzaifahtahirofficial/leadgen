# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Nestick runtime state (regenerate automatically; not for VCS)
.nestick_cache.sqlite
.nestick_cache.sqlite-shm
.nestick_cache.sqlite-wal
*.state.json
leads.csv
leads.json
leads.xlsx
out/

# Virtual environment created by the desktop launchers
.nestick-venv/

# Vercel frontend build output (generated by deploy/vercel/build.js)
deploy/vercel/dist/

# Local config (API keys live in ~/.nestick/config.json, never commit)
config.json

# Reference project (separate git repo — never embed as a submodule)
KeywordSearch/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
